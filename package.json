{
  "name": "grm-web-ide",
  "version": "0.1.0",
  "private": true,
  "description": "터미널에서 AI로 개발할 때 쓰는 브라우저 IDE (편집 없는 읽기 전용). grmide 명령으로 현재 디렉토리를 브라우저에서 본다.",
  "type": "module",
  "bin": {
    "grmide": "./bin/grmide.js"
  },
  "files": [
    "bin",
    "server",
    "web/dist"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "GRMIDE_DEV=1 node bin/grmide.js --no-open --port 4317",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node bin/grmide.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "vite": "^5.2.0",
    "vue": "^3.4.21"
  },
  "engines": {
    "node": ">=18"
  }
}
